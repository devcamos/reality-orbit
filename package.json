{
  "name": "reality-orbit",
  "version": "1.0.0",
  "private": true,
  "description": "An interactive orbit map for exploring dimensions of reality.",
  "scripts": {
    "build": "node scripts/build-static.mjs",
    "check": "node scripts/verify.mjs && node --test scripts/*.test.mjs",
    "check:generated": "npm run frame:desktop && git diff --exit-code -- index.html",
    "frame:desktop": "node scripts/configure-standalone-frame.mjs",
    "test": "node --test scripts/*.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:smoke": "node --test scripts/server-smoke.mjs",
    "start": "node scripts/serve.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.0"
  }
}
